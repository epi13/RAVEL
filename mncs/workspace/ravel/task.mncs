mncs 0.6;

// MNCS-native RAVEL task contexts.
//
// Every RAVEL episode must name the exact program state its reasoning refers
// to. A TaskContext carries the resident Language Service snapshot identity
// that produced it, bound through the shared ravel.types.v1 SnapshotId so
// every module agrees on identity structure. When the live workspace
// advances, the context is stale and every derived request is refused — with
// a payload naming the expected snapshot — instead of silently applied to
// drifted semantics. Evidence requests stay inside the declared authority
// domain and inside the step budget.
module ravel.task.v1;

use ravel.types.v1;
use mncs.core.logic.v1;

enum RequestDecision {
    ISSUE_REQUEST,
    REFUSE_STALE { expected: SnapshotId },
    REFUSE_AUTHORITY,
    REFUSE_BUDGET,
}

record TaskContext {
    task_id: i64,
    snapshot: SnapshotId,
    subject: i64,
    authority_domain: i64,
    budget_steps: i64,
}

record EvidenceRequest {
    task_id: i64,
    snapshot: SnapshotId,
    subject: i64,
    verifier: i64,
    max_steps: i64,
}

record PlannedRequest {
    decision: RequestDecision,
    request: EvidenceRequest,
}

// An inert request names the abandoned context so the caller can see exactly
// which semantic state was refused; zero subject and steps mark it dead.
fn inert(context: TaskContext, verifier: i64) -> (result: EvidenceRequest) {
    return EvidenceRequest {
        task_id: context.task_id,
        snapshot: context.snapshot,
        subject: 0,
        verifier: verifier,
        max_steps: 0,
    };
}

// Decide whether an evidence request may be issued under this context.
// Refusals are explicit and carry their reason; nothing is downgraded or
// retried against a different snapshot behind the caller's back. A stale
// refusal carries the snapshot the context was bound to, so the caller can
// compare it against the live workspace directly.
fn plan_request(
    context: TaskContext,
    live: SnapshotId,
    candidate_subject: i64,
    requested_domain: i64,
    requested_steps: i64,
    verifier: i64,
) -> (result: PlannedRequest) {
    let drifted: bool = bool_not(same_snapshot(context.snapshot, live));
    if drifted {
        return PlannedRequest {
            decision: RequestDecision.REFUSE_STALE { expected: context.snapshot },
            request: inert(context, verifier),
        };
    }
    let in_authority: bool = context.authority_domain == requested_domain;
    let on_subject: bool = context.subject == candidate_subject;
    if in_authority && on_subject {
        if affordable(context, requested_steps) {
            return PlannedRequest {
                decision: RequestDecision.ISSUE_REQUEST,
                request: EvidenceRequest {
                    task_id: context.task_id,
                    snapshot: context.snapshot,
                    subject: context.subject,
                    verifier: verifier,
                    max_steps: requested_steps,
                },
            };
        }
        return PlannedRequest {
            decision: RequestDecision.REFUSE_BUDGET,
            request: inert(context, verifier),
        };
    }
    return PlannedRequest {
        decision: RequestDecision.REFUSE_AUTHORITY,
        request: inert(context, verifier),
    };
}

fn affordable(context: TaskContext, requested_steps: i64) -> (result: bool) {
    return requested_steps <= context.budget_steps;
}
